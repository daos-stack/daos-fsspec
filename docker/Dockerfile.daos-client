FROM opensuse/leap:15.6@sha256:79be7751205ea84559990fb76b1bec71e38d6fad41c70a4f6c921b803b58f421

ARG DAOS_VERSION=2.6.5

RUN rpm --import "https://packages.daos.io/v${DAOS_VERSION}/DAOS_2025_1_GPG_KEY" && \
    zypper addrepo "https://packages.daos.io/v${DAOS_VERSION}/Leap15/packages/x86_64/" daos && \
    zypper --non-interactive install daos daos-client daos-devel gcc libuuid-devel && \
    zypper clean

ENV DAOS_VERSION=${DAOS_VERSION}

RUN zypper --non-interactive install python311 python311-pip && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install fsspec pytest pytest-asyncio pytest-timeout pandas pyarrow hypothesis h5py

RUN python3 -m pip install msgpack PyYAML scipy scikit-learn Pillow matplotlib cloudpickle

COPY . /tmp/daos-fsspec
RUN cd /tmp/daos-fsspec && python3 -m pip install --no-deps .

RUN mkdir -p /var/run/daos_agent

COPY docker/daos_agent.yml /etc/daos/daos_agent.yml
COPY docker/entrypoint-client.sh /usr/local/bin/entrypoint-client.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-client.sh"]
CMD ["sleep", "infinity"]
