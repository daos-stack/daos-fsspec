FROM opensuse/leap:15.6@sha256:79be7751205ea84559990fb76b1bec71e38d6fad41c70a4f6c921b803b58f421

ARG DAOS_VERSION=2.6.5

RUN rpm --import "https://packages.daos.io/v${DAOS_VERSION}/DAOS_2025_1_GPG_KEY" && \
    zypper addrepo "https://packages.daos.io/v${DAOS_VERSION}/Leap15/packages/x86_64/" daos && \
    zypper --non-interactive install daos daos-server daos-admin libaio1 && \
    zypper clean

ENV DAOS_VERSION=${DAOS_VERSION}

RUN mkdir -p /etc/daos/certs /var/run/daos_server && \
    if [ -f /usr/lib64/daos/certgen/gen_certificates.sh ]; then \
        cd /root && /usr/lib64/daos/certgen/gen_certificates.sh ; \
    fi

COPY docker/daos_server.yml /etc/daos/daos_server.yml
COPY docker/dmg.yml /etc/daos/dmg.yml
COPY docker/entrypoint-server.sh /usr/local/bin/entrypoint-server.sh

EXPOSE 10001

ENTRYPOINT ["/usr/local/bin/entrypoint-server.sh"]
